{
  "name": "writemd",
  "version": "1.2.0",
  "description": "A frictionless Markdown editor. Files stay on your machine.",
  "main": "./out/main/index.js",
  "author": "danieldamilola",
  "homepage": "https://github.com/danieldamilola/WriteMd",
  "repository": {
    "type": "git",
    "url": "https://github.com/danieldamilola/WriteMd.git"
  },
  "bugs": {
    "url": "https://github.com/danieldamilola/WriteMd/issues"
  },
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-electron.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.9",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@turbodocx/html-to-docx": "^1.22.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "katex": "^0.19.0",
    "lit": "^3.3.3",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  }
}

node_modules
dist
out
.DS_Store
.eslintcache

# Playwright artifacts. test-results/ is created per-run and playwright-report/
# is the HTML summary, which only appears on a failing run.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local UI review logs, reference snapshots, and scratch scripts.
# Curated visual evidence belongs in docs/screenshots/.
/artifacts/

# Local env files. electron-builder.yml already excludes these from the
# package, so the expectation exists; the ignore rule was missing.
.env
.env.*

temp-test-vault/

# Throwaway fixtures for the tab-strip e2e spec. Recreated on every run, never
# part of the repo.
.e2e-vault/
.e2e-userdata/

# Generated scratch output from ad-hoc scripts. Delete these rather than
# committing them (see the test*.js cleanup).
test-output.txt
test-results.txt

# Screenshots an e2e spec writes next to the repo root while it works out what a
# drag or a layout actually did. They are scratch output for whoever is looking
# at the failure, not assets.
tmp-*.png
tmp-*.jpg
tmp-*.jpeg

# Note: `*.log*` was removed. The pattern is broad enough to swallow real
# source and docs (anything with a `.log` segment, e.g. docs/dialog.log.md or
# src/**/blog.settings.ts). Use `*.log` and `*.log.*` instead.
*.log
*.log.*

# The folder WriteMd itself creates for pasted and dropped images. Anything that
# lands here is scratch from a paste, not project content, so it should never be
# committed. README screenshots live in docs/screenshots/ instead.
/_assets/

# Debug screenshots the Playwright specs write into the working directory. They
# exist to be looked at during a run, not kept.
tmp-*.png
